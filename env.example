# Ports publiés sur l’hôte (conflits avec d’autres apps)
FONAREDD_APP_DEV_PORT=13000
FONAREDD_APP_PROD_PORT=13001
FONAREDD_REDIS_PORT=16379
FONAREDD_CADDY_HTTP=18080

# MySQL installé sur le serveur (pas dans Docker). Depuis les conteneurs app :
# utilisez host.docker.internal (mappé via host-gateway dans docker-compose).
# Exemple si MySQL écoute sur le port 3306 de l’hôte :
DATABASE_URL="mysql://username:password@host.docker.internal:3306/fonaredd_db?allowPublicKeyRetrieval=true&ssl=false"

# Pool Prisma / MariaDB (évite le blocage MySQL « Host is blocked » / max_connect_errors)
# Un pool trop grand multiplie les échecs de connexion depuis Docker (172.18.0.x).
# Local/Docker : 5. MySQL distant (Tailscale) : 8 (import CSV + APIs parallèles).
DB_CONNECTION_LIMIT=8
# Local/Docker : 3000 / 8000. MySQL distant (Tailscale) : 15000 / 60000
DB_CONNECT_TIMEOUT_MS=3000
DB_ACQUIRE_TIMEOUT_MS=60000
DB_IDLE_TIMEOUT_SEC=60
# Côté MySQL (recommandé une fois) :
#   SET GLOBAL max_connect_errors = 100000;
#   # et dans my.cnf : max_connect_errors = 100000
# Si déjà bloqué : sudo mysqladmin flush-hosts

JWT_SECRET="votre_cle_secrete_jwt_tres_longue_et_complexe"

# URL publique (production derrière Cloudflare)
NEXTAUTH_URL="https://fonaredd.com"
NEXTAUTH_SECRET="votre_cle_secrete_nextauth"

NODE_ENV="development"
