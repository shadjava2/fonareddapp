generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
}

model utilisateurs {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nom          String   @db.VarChar(50)
  postnom      String?  @db.VarChar(50)
  prenom       String?  @db.VarChar(50)
  username     String   @db.VarChar(30)
  mot_de_passe String   @db.VarChar(255)
  mail         String?  @db.VarChar(255)
  phone        String?  @db.VarChar(255)
  locked       Boolean
  fkFonction   BigInt?  @db.UnsignedBigInt
  fkRole       BigInt?  @db.UnsignedBigInt
  initPassword Boolean? @default(false)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  fonction              fonctions?               @relation(fields: [fkFonction], references: [id])
  role                  roles?                   @relation(fields: [fkRole], references: [id])
  droitsServices        droits_services[]
  connexionHistoriques  ConnexionHistorique[]
  retraitsNonJustifies  CongeNonJustifieRetrait[]
  acsUsers              acs_users[]

  @@index([fkRole, id], map: "fkroleindexuser")
  @@index([fkFonction], map: "fkfonctionindexuser")
  @@index([username], map: "userunique")
  @@map("utilisateurs")
}

/// Journal des connexions réussies (sécurité compte utilisateur)
model ConnexionHistorique {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fkUtilisateur BigInt   @db.UnsignedBigInt
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(512)
  datecreate    DateTime @default(now()) @db.Timestamp(0)

  utilisateur utilisateurs @relation(fields: [fkUtilisateur], references: [id], onDelete: Cascade)

  @@index([fkUtilisateur], map: "fk_connexion_user")
  @@index([fkUtilisateur, datecreate], map: "idx_connexion_user_date")
  @@map("connexion_historique")
}

model fonctions {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nom          String   @db.VarChar(50)
  description  String   @db.VarChar(100)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  utilisateurs utilisateurs[]

  @@index([id], map: "index_fonction_unique")
  @@map("fonctions")
}

model roles {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nom          String   @unique(map: "UNIQUEROLE") @db.VarChar(50)
  description  String?  @db.VarChar(100)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  utilisateurs     utilisateurs[]
  rolesPermissions roles_permissions[]

  @@index([id], map: "ndex_role_unique")
  @@map("roles")
}

model permissions {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nom          String   @unique(map: "uniquepermission") @db.VarChar(255)
  description  String?  @db.VarChar(255)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  rolesPermissions roles_permissions[]

  @@index([id], map: "index_permission_unique")
  @@map("permissions")
}

model services {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fkSite       BigInt?  @db.UnsignedBigInt
  designation  String?  @db.LongText
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  site           sites?            @relation(fields: [fkSite], references: [id])
  droitsServices droits_services[]

  @@index([id, fkSite], map: "index_pharmacie_unique")
  @@index([fkSite], map: "key_service")
  @@map("services")
}

model sites {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  designation  String?  @db.VarChar(100)
  abbreviation String?  @db.VarChar(20)
  adresse      String?  @db.VarChar(255)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  services services[]

  @@index([id], map: "index_unique_code")
  @@map("sites")
}

model roles_permissions {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fkRole       BigInt   @db.UnsignedBigInt
  fkPermission BigInt   @db.UnsignedBigInt
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  // Relations
  role       roles       @relation(fields: [fkRole], references: [id])
  permission permissions @relation(fields: [fkPermission], references: [id])

  @@index([fkRole], map: "fk_key_role")
  @@index([fkPermission], map: "fk_permis")
  @@index([id, fkRole, fkPermission], map: "index_roleperimis_unique")
  @@map("roles_permissions")
}

model droits_services {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fkUtilisateur BigInt?  @db.UnsignedBigInt
  fkService     BigInt?  @db.UnsignedBigInt
  datecreate    DateTime @default(now()) @db.Timestamp(0)
  usercreateid  BigInt?

  // Relations
  utilisateur utilisateurs? @relation(fields: [fkUtilisateur], references: [id])
  service     services?     @relation(fields: [fkService], references: [id])

  @@index([fkService], map: "fkservice_key")
  @@index([fkUtilisateur, fkService, id], map: "index_droitpharmacie_unique")
  @@map("droits_services")
}

model calendrier {
  id           BigInt   @id @default(autoincrement())
  d            DateTime @db.Date
  label        String?  @db.VarChar(120)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?
  userupdateid BigInt?

  @@map("calendrier")
}

model congeconfig {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nbjourMois       Float    @unique(map: "UNIQUEROLE") @db.Float
  /// Plafond annuel de jours de congé non justifié autorisés (réinitialisé en janvier sur congesolde)
  congenonjustifie Float?   @db.Float
  datecreate       DateTime @default(now()) @db.Timestamp(0)
  dateupdate       DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid     BigInt?  @db.UnsignedBigInt
  userupdateid     BigInt?  @db.UnsignedBigInt

  @@index([id], map: "ndex_role_unique")
  @@map("congeconfig")
}

model congedemande {
  id              BigInt               @id @default(autoincrement())
  fkSoldes        String?              @db.VarChar(255)
  fkTypeConge     BigInt?
  section         String?              @db.VarChar(255)
  remiseetreprise String?              @db.Text
  nbrjour         Float?               @db.Float
  soldeconge      Float?               @db.Float
  du              DateTime?            @db.Date
  au              DateTime?            @db.Date
  statut          congedemande_statut? @default(BROUILLON)
  niveau          Int?                 @default(0)
  demandeur       String?              @db.VarChar(255)
  idremplacant    BigInt?
  nomsremplacant  String?              @db.VarChar(255)
  datecreate      DateTime             @default(now()) @db.Timestamp(0)
  dateupdate      DateTime?            @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid    BigInt?
  userupdateid    BigInt?

  @@map("congedemande")
}

model congesolde {
  id               BigInt    @id @default(autoincrement())
  fkUtilisateur    BigInt?
  solde            Float?    @db.Float
  soldeConsomme    Float?    @db.Float
  /// Jours non justifiés restants sur l’année (décrémenté à chaque retrait ; reset janvier / décembre selon scheduler)
  congenonjustifie Float?    @db.Float
  datecreate       DateTime  @default(now()) @db.Timestamp(0)
  dateupdate       DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid     BigInt?
  userupdateid     BigInt?

  @@map("congesolde")
}

/// Historique des retraits de congés non justifiés
model CongeNonJustifieRetrait {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fkUtilisateur  BigInt    @db.UnsignedBigInt
  nbrjours       Float     @db.Float
  commentaire    String?   @db.VarChar(500)
  resteApres     Float?    @db.Float
  /// Période couverte (pour affichage dans les rapports de présence)
  dateDebut      DateTime? @db.Date
  dateFin        DateTime? @db.Date
  datecreate     DateTime  @default(now()) @db.Timestamp(0)
  usercreateid   BigInt?   @db.UnsignedBigInt

  utilisateur utilisateurs @relation(fields: [fkUtilisateur], references: [id], onDelete: Cascade)

  @@index([fkUtilisateur], map: "fk_nj_user")
  @@index([datecreate], map: "idx_nj_date")
  @@index([dateDebut, dateFin], map: "idx_nj_periode")
  @@map("congenonjustifie_retrait")
}

model retourconge {
  id           BigInt    @id @default(autoincrement())
  fkDemande    BigInt?
  fkSoldes     BigInt?
  observations String?   @db.Text
  nbrjour      Int?      @db.TinyInt
  datecreate   DateTime  @default(now()) @db.Timestamp(0)
  dateupdate   DateTime? @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid BigInt?
  userupdateid BigInt?

  @@map("retourconge")
}

model urgenceindisponibilites {
  id             BigInt                          @id @default(autoincrement())
  fkUtilisateur1 BigInt? // Agent indisponible
  fkUtilisateur2 BigInt? // Remplaçant pendant la période d'urgence
  observations   String?                         @db.Text
  du             DateTime?                       @db.Date
  au             DateTime?                       @db.Date
  statut         urgenceindisponibilites_statut?
  datecreate     DateTime                        @default(now()) @db.Timestamp(0)
  dateupdate     DateTime?                       @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid   BigInt?
  userupdateid   BigInt?

  @@map("urgenceindisponibilites")
}

model notifications {
  id                   BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  fkUtilisateur        BigInt?                         @db.UnsignedBigInt
  type_notification    notifications_type_notification
  statut               notifications_statut?           @default(en_attente)
  sujet                String?                         @db.VarChar(255)
  contenu              String?                         @db.Text
  adresse_destinataire String                          @db.VarChar(255)
  date_programmee      DateTime                        @default(now()) @db.Timestamp(0)
  date_envoi           DateTime                        @default(now()) @db.Timestamp(0)
  datecreate           DateTime                        @default(now()) @db.Timestamp(0)
  dateupdate           DateTime                        @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid         BigInt?
  userupdateid         BigInt?

  @@index([fkUtilisateur], map: "index_notif_unique")
  @@map("notifications")
}

model congephase {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  designation   String?  @db.VarChar(255)
  ordrephase    Boolean?
  conformefiled Boolean?
  datecreate    DateTime @default(now()) @db.Timestamp(0)
  dateupdate    DateTime @default(now()) @db.Timestamp(0)
  usercreateid  BigInt?
  userupdateid  BigInt?
}

model congetraitements {
  id           BigInt    @id @default(autoincrement())
  fkDemande    BigInt?   @default(0)
  fkPhase      BigInt?   @default(0)
  observations String?   @db.Text
  conformite   Boolean?
  approbation  Boolean?
  datecreate   DateTime  @default(now()) @db.Timestamp(0)
  dateupdate   DateTime? @default(now()) @db.Timestamp(0)
  usercreateid BigInt?
  userupdateid BigInt?
}

model congetypes {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nom          String   @unique(map: "UNIQUEROLE") @db.VarChar(50)
  description  String?  @db.VarChar(100)
  datecreate   DateTime @default(now()) @db.Timestamp(0)
  dateupdate   DateTime @default(now()) @db.Timestamp(0)
  usercreateid BigInt?  @db.UnsignedBigInt
  userupdateid BigInt?  @db.UnsignedBigInt

  @@index([id], map: "ndex_role_unique")
}

model acs_cards {
  id          BigInt  @id @default(autoincrement())
  device_ip   String  @db.VarChar(64)
  employee_no String  @db.VarChar(64)
  card_no     String  @db.VarChar(64)
  status      String? @db.VarChar(32)
  raw         Json

  @@unique([device_ip, card_no], map: "uniq_device_card")
  @@index([employee_no], map: "idx_employee")
}

model acs_events {
  id            BigInt   @id @default(autoincrement())
  device_ip     String   @db.VarChar(64)
  event_index   BigInt
  event_time    DateTime
  event_type    String   @db.VarChar(64)
  door_no       Int?
  direction     String?  @db.VarChar(16)
  card_no       String?  @db.VarChar(64)
  employee_no   String?  @db.VarChar(64)
  /// Nom personne (iVMS / CSV) pour affichage si pas encore dans acs_users
  person_name   String?  @db.VarChar(128)
  /// Point de contrôle iVMS (ex. Fonaredd_Door1_Entrance…)
  checkpoint    String?  @db.VarChar(255)
  device_serial String?  @db.VarChar(64)
  /// Libellé Custom Name iVMS (Entrée Service, …)
  custom_status String?  @db.VarChar(128)
  data_source   String?  @db.VarChar(64)
  /// Origine : ivms_push | ivms_csv | isapi | manual
  source        String?  @db.VarChar(32)
  photo_path    String?  @db.VarChar(500)
  raw           Json

  @@unique([device_ip, event_index], map: "uniq_device_event")
  @@index([card_no], map: "idx_card")
  @@index([employee_no], map: "idx_employee")
  @@index([event_time], map: "idx_time")
  @@index([checkpoint], map: "idx_checkpoint")
  @@index([source], map: "idx_source")
}

model acs_users {
  id             BigInt  @id @default(autoincrement())
  device_ip      String  @db.VarChar(64)
  employee_no    String  @db.VarChar(64)
  name           String?
  department     String?
  face_path      String? @db.VarChar(500)
  /// Lien optionnel vers le compte applicatif (rapports : nom / fonction / rôle / service)
  system_user_id BigInt? @db.UnsignedBigInt
  raw            Json

  systemUser utilisateurs? @relation(fields: [system_user_id], references: [id], onDelete: SetNull)

  @@unique([device_ip, employee_no], map: "uniq_device_employee")
  @@unique([system_user_id], map: "uniq_acs_system_user")
  @@index([name], map: "idx_name")
}

/// Table tampon écrite par iVMS-4200 (Third-Party Database → MySQL).
/// Configurer le mapping iVMS sur ces noms de colonnes exacts.
model ivms_attendance {
  id            BigInt    @id @default(autoincrement())
  /// ID fourni par iVMS (champ « ID »)
  ivms_id       BigInt?   @unique(map: "uniq_ivms_id")
  auth_datetime DateTime  @db.DateTime(0)
  auth_date     DateTime? @db.Date
  auth_time     String?   @db.VarChar(16)
  direction     String?   @db.VarChar(32)
  device_name   String?   @db.VarChar(128)
  device_serial String?   @db.VarChar(64)
  person_name   String?   @db.VarChar(128)
  card_no       String?   @db.VarChar(64)
  /// Optionnel si vous mappez un champ Person ID côté iVMS
  employee_no   String?   @db.VarChar(64)
  received_at   DateTime  @default(now()) @db.DateTime(0)
  normalized_at DateTime? @db.DateTime(0)

  @@index([auth_datetime], map: "idx_ivms_auth_datetime")
  @@index([normalized_at], map: "idx_ivms_normalized")
  @@index([person_name], map: "idx_ivms_person")
  @@index([card_no], map: "idx_ivms_card")
  @@map("ivms_attendance")
}

/// Configuration du lecteur Hikvision (source de vérité en base)
model hikvision_config {
  id                    Int      @id @default(1)
  ip                    String   @db.VarChar(64)
  port                  Int      @default(80)
  username              String   @db.VarChar(64)
  password              String   @db.VarChar(255)
  timezone_offset_minutes Int?   @map("timezone_offset_minute") @db.SmallInt
  updated_at            DateTime @updatedAt @db.DateTime(0)

  @@map("hikvision_config")
}

/// Règles Timetable présence (aligné iVMS Default Timetable) — une ligne id=1
model presence_rules {
  id                            Int      @id @default(1)
  /// HH:mm — fin plage « à l’heure » (entrée)
  start_work_time               String   @default("08:30") @db.VarChar(8)
  /// HH:mm — fin de service (sortie)
  end_work_time                 String   @default("18:00") @db.VarChar(8)
  /// Entrée — à l’heure dès
  checkin_valid_from            String   @default("08:00") @db.VarChar(8)
  /// Entrée — absent dès
  checkin_valid_to              String   @default("09:30") @db.VarChar(8)
  /// Entrée — retard dès
  late_from                     String   @default("08:40") @db.VarChar(8)
  /// Entrée — retard jusqu’à
  late_until                    String   @default("09:10") @db.VarChar(8)
  /// Sortie — fenêtre normale dès
  checkout_valid_from           String   @default("17:30") @db.VarChar(8)
  /// Sortie — fenêtre normale jusqu’à
  checkout_valid_to             String   @default("18:30") @db.VarChar(8)
  late_allowable_minutes        Int      @default(10)
  early_leave_allowable_minutes Int      @default(10)
  /// Legacy — non utilisé si checkin_valid_to est renseigné
  absent_after_hours            Int      @default(3)
  /// Sortie/Retour Mission (Break) comptés comme présence
  count_mission_as_presence     Boolean  @default(true)
  score_on_time                 Int      @default(100)
  score_late                    Int      @default(70)
  score_early_leave             Int      @default(80)
  score_late_exit               Int      @default(90)
  score_absent                  Int      @default(0)
  score_mission_day             Int      @default(95)
  excellent_min                 Int      @default(90)
  bon_min                       Int      @default(75)
  moyen_min                     Int      @default(50)
  updated_at                    DateTime @updatedAt @db.DateTime(0)

  @@map("presence_rules")
}

/// Actions gestionnaire sur les cas détectés par le monitoring de présence (notes circulaires)
model PresenceMonitoringAction {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  employee_no    String   @db.VarChar(64)
  year           Int
  /// Mois 1–12 (0 = cas annuel)
  month          Int      @db.TinyInt
  rule_code      String   @db.VarChar(32)
  /// pending | observation | explication_demandee | blame_declenche | revocation_proposee | retrait_conge_fait | justification_recue
  action         String   @default("pending") @db.VarChar(40)
  metric_value   Float?   @db.Float
  /// JSON : dates, jours débités, flags idempotence…
  detail         String?  @db.Text
  notes          String?  @db.VarChar(500)
  datecreate     DateTime @default(now()) @db.Timestamp(0)
  dateupdate     DateTime @default(now()) @updatedAt @db.Timestamp(0)
  usercreateid   BigInt?  @db.UnsignedBigInt
  userupdateid   BigInt?  @db.UnsignedBigInt

  @@unique([employee_no, year, month, rule_code], map: "uniq_presence_mon_case")
  @@index([year, month], map: "idx_presence_mon_period")
  @@index([action], map: "idx_presence_mon_action")
  @@map("presence_monitoring_action")
}

model ad_item {
  id               BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  slot_code        String               @db.VarChar(64)
  lang             String?              @default("fr") @db.VarChar(8)
  title            String               @db.VarChar(180)
  subtitle         String?              @db.VarChar(240)
  content_html     String?              @db.MediumText
  cta_label        String?              @db.VarChar(80)
  cta_url          String?              @db.VarChar(500)
  media_type       ad_item_media_type?  @default(image)
  hero_image_url   String?              @db.VarChar(500)
  start_at         DateTime             @default(now()) @db.DateTime(0)
  end_at           DateTime?            @db.DateTime(0)
  days_mask        String?
  start_time       DateTime?            @db.Time(0)
  end_time         DateTime?            @db.Time(0)
  status           ad_item_status?      @default(draft)
  priority         Int?                 @default(5) @db.UnsignedTinyInt
  weight           Int?                 @default(1) @db.UnsignedTinyInt
  loop_seconds     Int?                 @default(8) @db.UnsignedInt
  orientation      ad_item_orientation? @default(auto)
  animation_preset String?              @db.VarChar(64)
  bg_color         String?              @db.VarChar(16)
  text_color       String?              @db.VarChar(16)
  theme            ad_item_theme?       @default(auto)
  impressions      BigInt               @default(0) @db.UnsignedBigInt
  clicks           BigInt               @default(0) @db.UnsignedBigInt
  max_impressions  BigInt?              @db.UnsignedBigInt
  created_by       BigInt?              @db.UnsignedBigInt
  updated_by       BigInt?              @db.UnsignedBigInt
  created_at       DateTime             @default(now()) @db.DateTime(0)
  updated_at       DateTime             @default(now()) @db.DateTime(0)
  published_at     DateTime?            @db.DateTime(0)
  ad_slot          ad_slot              @relation(fields: [slot_code], references: [code], map: "fk_ad_item_slot")
  ad_media         ad_media[]

  @@index([lang], map: "idx_lang")
  @@index([priority, weight], map: "idx_priority_weight")
  @@index([slot_code, status, start_at, end_at], map: "idx_slot_status_time")
}

model ad_media {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ad_item_id BigInt   @db.UnsignedBigInt
  url        String   @db.VarChar(500)
  alt_text   String?  @db.VarChar(160)
  position   Int      @default(1) @db.UnsignedSmallInt
  width      Int?
  height     Int?
  mime_type  String?  @db.VarChar(100)
  created_at DateTime @default(now()) @db.DateTime(0)
  ad_item    ad_item  @relation(fields: [ad_item_id], references: [id], onDelete: Cascade, map: "fk_ad_media_item")

  @@index([ad_item_id, position], map: "idx_media_item_pos")
}

model ad_slot {
  code              String                     @id @db.VarChar(64)
  description       String                     @db.VarChar(255)
  device            ad_slot_device?            @default(any)
  max_items         Int?                       @default(10) @db.UnsignedTinyInt
  rotation_strategy ad_slot_rotation_strategy? @default(weight)
  width_px          Int?
  height_px         Int?
  created_at        DateTime                   @default(now()) @db.DateTime(0)
  updated_at        DateTime                   @default(now()) @db.DateTime(0)
  ad_item           ad_item[]
}

enum notifications_type_notification {
  email
  sms
}

enum notifications_statut {
  en_attente @map("en attente")
  envoy_e    @map("envoyée")
  chou_e     @map("échouée")
}

